# Copy to .env and fill in / adjust the values:  cp .env.example .env
# The .env file is in .gitignore - never commit it.

# --- InfluxDB 2.x ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change_me_strong_password
INFLUXDB_ORG=home
INFLUXDB_BUCKET=metrics
# 0 = data is never deleted (retention disabled). Otherwise e.g. 90d, 52w...
INFLUXDB_RETENTION=0
# Admin/operator token. Generate e.g. with:  openssl rand -hex 32
INFLUXDB_ADMIN_TOKEN=generate_a_long_random_token

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password
